| -------- | ------------------------- |
{{ for trigger in change.build_definition.after_ci_triggers ~}}
| {{ trigger.use_yaml }} | {{ trigger.override }} |
{{ end ~}}

{{ else if change.action == "delete" && change.build_definition && change.build_definition.before_ci_triggers.size > 0 ~}}
#### CI Trigger (being deleted)

| Use YAML | Override (Branch Filters) |
| -------- | ------------------------- |
{{ for trigger in change.build_definition.before_ci_triggers ~}}
| {{ trigger.use_yaml }} | {{ trigger.override }} |
{{ end ~}}

{{ else if change.build_definition && (change.build_definition.after_ci_triggers.size > 0 || change.build_definition.before_ci_triggers.size > 0) ~}}
#### CI Trigger

| Use YAML | Override (Branch Filters) |
| -------- | ------------------------- |
{{ for trigger in change.build_definition.after_ci_triggers ~}}
| {{ trigger.use_yaml }} | {{ trigger.override }} |
{{ end ~}}

