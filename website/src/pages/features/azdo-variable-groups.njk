      </div>
      <div class="feature-highlight-card">
        <div class="feature-highlight-icon">📝</div>
        <h3 class="feature-highlight-title">Complete Metadata</h3>
        <p class="feature-highlight-desc">Group name, description, project references, and Key Vault integration details remain available for full review context.</p>
      </div>
    </div>
  </div>
</section>

