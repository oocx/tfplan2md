      "before_sensitive": false,
      "after_sensitive": false
    }
  },
  "configuration": {
    "root_module": {
      "variables": {
        "old_var_a": {
          "deprecated": "Use new_var_a instead."
        },
        "old_var_b": {
          "deprecated": "Use new_var_b instead."
        }
      },
      "outputs": {
