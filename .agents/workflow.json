{
  "_comment": "Stage sequences and gate rules. Read by scripts/workflow-next.sh, workflow-gate.sh and wp-append.sh. Role display names are not duplicated here — they come from the `name:` frontmatter of .agents/roles/<stage>.md.",
  "types": {
    "feature": {
      "folder": "docs/features",
      "branch_prefix": "feature",
      "stages": [
        "requirements-engineer",
        "architect",
        "quality-engineer",
        "task-planner",
        "developer",
        "technical-writer",
        "code-reviewer",
        "uat-tester",
        "release-manager",
        "retrospective"
      ],
      "conditional_stages": [
        "uat-tester"
      ],
      "gate_blocking_stages": [
        "requirements-engineer",
        "architect",
        "quality-engineer",
        "task-planner",
        "developer",
        "technical-writer",
        "code-reviewer"
      ]
    },
    "fix": {
      "folder": "docs/issues",
      "branch_prefix": "fix",
      "stages": [
        "issue-analyst",
        "developer",
        "technical-writer",
        "code-reviewer",
        "uat-tester",
        "release-manager",
        "retrospective"
      ],
      "conditional_stages": [
        "uat-tester"
      ],
      "gate_blocking_stages": [
        "issue-analyst",
        "developer",
        "technical-writer",
        "code-reviewer"
      ]
    },
    "workflow": {
      "folder": "docs/workflow",
      "branch_prefix": "workflow",
      "stages": [
        "workflow-engineer",
        "release-manager"
      ],
      "conditional_stages": [],
      "gate_blocking_stages": [
        "workflow-engineer"
      ]
    },
    "website": {
      "folder": "docs/website",
      "branch_prefix": "website",
      "stages": [
        "web-designer",
        "release-manager"
      ],
      "conditional_stages": [],
      "gate_blocking_stages": [
        "web-designer"
      ]
    }
  },
  "gates": {
    "spec": {
      "after_stage": "requirements-engineer",
      "always": true,
      "prompt": "Specification approval. Review specification.md and approve, or say what to change."
    },
    "arch": {
      "after_stage": "architect",
      "always": false,
      "condition": "state.gates.arch == 'contested'",
      "prompt": "Architecture choice. Two or more options carry material trade-offs; pick one."
    },
    "uat": {
      "after_stage": "uat-tester",
      "always": false,
      "condition": "diff touches user-visible output",
      "prompt": "UAT approval. Review the rendered output in both PRs the UAT Tester created, and reply approved or rejected."
    }
  },
  "uat_trigger_paths": "^(src/Oocx\\.TfPlan2Md/(MarkdownGeneration|RenderTargets)/|examples/|website/)",
  "rework_targets": {
    "code-reviewer": "developer",
    "uat-tester": "developer",
    "release-manager": "developer"
  }
}
