{% macro providerCard(provider, rootPrefix="") %}
<div class="feature-category-card">
  <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 16px;">
    <div class="feature-icon" style="margin: 0; font-size: 32px;">{{ provider.icon }}</div>
    <div>
      <h3 style="margin: 0;">{{ provider.title }}</h3>
      <span style="display: inline-block; padding: 4px 12px; background: {{ provider.statusColor }}; color: white; border-radius: 12px; font-size: 12px; font-weight: 600; margin-top: 4px;">{{ provider.status }}</span>
    </div>
  </div>

  <p>{{ provider.description }}</p>

  {% for section in provider.sections %}
  <h4 style="margin-top: 24px; margin-bottom: 12px; font-size: 16px;">{{ section.title }}</h4>
  <ul style="margin-left: 20px; font-size: 14px;">
    {% for item in section.items %}
    <li style="margin-bottom: 8px;">{{ item | safe }}</li>
    {% endfor %}
  </ul>
  {% endfor %}

  {% if provider.note %}
  <p style="margin-top: 24px; padding: 12px; background: var(--color-surface); border-left: 3px solid {{ provider.noteBorderColor or 'var(--color-primary)' }}; font-size: 14px;">
    {{ provider.note | safe }}
  </p>
  {% endif %}

  {% if provider.actions and provider.actions.length %}
  <div style="display: flex; gap: 12px; margin-top: 24px;">
    {% for action in provider.actions %}
    <a href="{{ action.href }}" class="btn btn-{{ action.variant or 'secondary' }}" style="{% if action.fullWidth %}width: 100%;{% else %}flex: 1;{% endif %} text-align: center;"{% if action.external %} target="_blank" rel="noopener noreferrer"{% endif %}>{{ action.label }}</a>
    {% endfor %}
  </div>
  {% endif %}
</div>
{% endmacro %}