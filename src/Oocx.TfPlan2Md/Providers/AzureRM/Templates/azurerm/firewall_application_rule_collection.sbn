{{~## Template for azurerm_firewall_application_rule_collection
      Provides semantic diffing of application firewall rules instead of index-based changes.
      Access properties via 'change' variable - works for both include and direct render paths.
~}}
<details{{ if change.code_analysis_findings.size > 0 }} open{{ end }} style="margin-bottom:12px; border:1px solid rgb(var(--palette-neutral-10, 153, 153, 153)); padding:12px;">
<summary>{{ change.summary_html }}</summary>
<br>
{{~ include "/_code_analysis_metadata.sbn" ~}}

{{~ if change.firewall_application_rule_collection && change.firewall_application_rule_collection.name ~}}
**Collection:** `{{ change.firewall_application_rule_collection.name | escape_markdown }}` | **Priority:** `{{ change.firewall_application_rule_collection.priority | escape_markdown }}` | **Action:** {{ change.firewall_application_rule_collection.action }}
{{~ end ~}}

{{~ if change.before_json && change.after_json && change.firewall_application_rule_collection && change.firewall_application_rule_collection.rule_changes.size > 0 ~}}

#### Rule Changes{{ "\n" }}

| Change | Rule Name | Protocols | Source Addresses | Source IP Groups | Target FQDNs | FQDN Tags | Description |
| -------- | ----------- | ----------- | ------------------ | ------------------ | ------------- | ----------- | ------------- |
{{~ for row in change.firewall_application_rule_collection.rule_changes ~}}
| {{ row.change }} | {{ row.name }} | {{ row.protocols }} | {{ row.source_addresses }} | {{ row.source_ip_groups }} | {{ row.target_fqdns }} | {{ row.fqdn_tags }} | {{ row.description }} |
{{ end }}


{{~ else if change.action == "create" && change.firewall_application_rule_collection && change.firewall_application_rule_collection.after_rules.size > 0 ~}}
#### Application Rules{{ "\n" }}

| Rule Name | Protocols | Source Addresses | Source IP Groups | Target FQDNs | FQDN Tags | Description |
| ----------- | ----------- | ------------------ | ------------------ | ------------- | ----------- | ------------- |
{{~ for row in change.firewall_application_rule_collection.after_rules ~}}
| {{ row.name }} | {{ row.protocols }} | {{ row.source_addresses }} | {{ row.source_ip_groups }} | {{ row.target_fqdns }} | {{ row.fqdn_tags }} | {{ row.description }} |
{{~ end ~}}

{{~ else if change.action == "delete" && change.firewall_application_rule_collection && change.firewall_application_rule_collection.before_rules.size > 0 ~}}
#### Rules (being deleted)

| Rule Name | Protocols | Source Addresses | Source IP Groups | Target FQDNs | FQDN Tags | Description |
| ----------- | ----------- | ------------------ | ------------------ | ------------- | ----------- | ------------- |
{{~ for row in change.firewall_application_rule_collection.before_rules ~}}
| {{ row.name }} | {{ row.protocols }} | {{ row.source_addresses }} | {{ row.source_ip_groups }} | {{ row.target_fqdns }} | {{ row.fqdn_tags }} | {{ row.description }} |
{{~ end ~}}

{{~ else ~}}
{{~ if change.attribute_changes && change.attribute_changes.size > 0 ~}}
<details>
<summary>Attribute Changes</summary>

{{~ if change.action == "create" ~}}
| Attribute | Value |
| ----------- | ------- |
{{~ for attr in change.attribute_changes ~}}
{{~ indicator = get_attribute_finding_indicator attr.name change.code_analysis_findings ~}}
| {{ attr.name | escape_markdown }}{{ indicator }} | {{ (attr.after ?? "(null)") | escape_markdown }} |
{{~ end ~}}
{{~ else if change.action == "delete" ~}}
| Attribute | Value |
| ----------- | ------- |
{{~ for attr in change.attribute_changes ~}}
{{~ indicator = get_attribute_finding_indicator attr.name change.code_analysis_findings ~}}
| {{ attr.name | escape_markdown }}{{ indicator }} | {{ (attr.before ?? "(null)") | escape_markdown }} |
{{~ end ~}}
{{~ else ~}}
| Attribute | Before | After |
| ----------- | -------- | ------- |
{{~ for attr in change.attribute_changes ~}}
{{~ indicator = get_attribute_finding_indicator attr.name change.code_analysis_findings ~}}
| {{ attr.name | escape_markdown }}{{ indicator }} | {{ (attr.before ?? "(null)") | escape_markdown }} | {{ (attr.after ?? "(null)") | escape_markdown }} |
{{~ end ~}}
{{~ end ~}}

</details>
{{~ end ~}}
{{~ end ~}}

{{ include "/_code_analysis_findings.sbn" }}

</details>
