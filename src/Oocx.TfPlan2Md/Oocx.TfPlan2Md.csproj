<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>13</LangVersion>
    <RootNamespace>Oocx.TfPlan2Md</RootNamespace>
    <Version>1.33.0</Version>
    <AssemblyName>tfplan2md</AssemblyName>
    <RuntimeIdentifiers>linux-x64;linux-arm64;win-x64;win-arm64;osx-x64;osx-arm64</RuntimeIdentifiers>
    <PublishAot>true</PublishAot>
    <IlcDisableReflection>true</IlcDisableReflection>
    <TrimMode>full</TrimMode>
    <StripSymbols>true</StripSymbols>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IlcOptimizationPreference>Size</IlcOptimizationPreference>
    <StackTraceSupport>false</StackTraceSupport>
    <IlcFoldIdenticalMethodBodies>true</IlcFoldIdenticalMethodBodies>
    <EventSourceSupport>false</EventSourceSupport>
    <UseSizeOptimizedLinq>true</UseSizeOptimizedLinq>
    <MetricsSupport>false</MetricsSupport>
    <Http3Support>false</Http3Support>
    <IlcGenerateStackTraceData>false</IlcGenerateStackTraceData>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <HttpActivityPropagationSupport>false</HttpActivityPropagationSupport>
    <MetadataUpdaterSupport>false</MetadataUpdaterSupport>
    <WarningsNotAsErrors>IL2067;IL2070;IL2075;IL2080;IL2104;IL3050;IL3053</WarningsNotAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <Target Name="SetSourceRevisionId" BeforeTargets="GenerateAssemblyInfo" Condition="'$(SourceRevisionId)'==''">
    <Exec Command="git rev-parse --short HEAD" ConsoleToMSBuild="true" IgnoreExitCode="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="SourceRevisionIdFromGit" />
    </Exec>
    <PropertyGroup>
      <SourceRevisionId Condition="'$(SourceRevisionId)'=='' and '$(SourceRevisionIdFromGit)'!=''">$([System.String]::Copy('$(SourceRevisionIdFromGit)').Trim())</SourceRevisionId>
    </PropertyGroup>
  </Target>

  <ItemGroup>
    <InternalsVisibleTo Include="Oocx.TfPlan2Md.TUnit" />
    <ProjectReference Include="../tools/JsonEmbedGenerator/JsonEmbedGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" GlobalPropertiesToRemove="PublishAot" />
    <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="EmbedAsJson" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="Platforms/Azure/AzureRoleDefinitions.json" EmbedAsJson="true" />
    <AdditionalFiles Include="Providers/AzApi/Data/AzureApiDocumentationMappings.json" EmbedAsJson="true" />
    <AdditionalFiles Include="Providers/Shared/Icons/azure-common-icons.json" EmbedAsJson="true" />
    <AdditionalFiles Include="Providers/AzureAD/Icons/azuread-icons.json" EmbedAsJson="true" />
    <AdditionalFiles Include="Providers/AzureDevOps/Icons/azuredevops-icons.json" EmbedAsJson="true" />
  </ItemGroup>

  <Target Name="GenerateBuildInfo" BeforeTargets="CoreCompile" DependsOnTargets="SetSourceRevisionId">
    <PropertyGroup>
      <_BuildInfoFile>$(IntermediateOutputPath)BuildInfo.g.cs</_BuildInfoFile>
      <_BuildInfoVersion Condition="'$(Version)'!=''">$([System.String]::Copy('$(Version)').Trim())</_BuildInfoVersion>
      <_BuildInfoVersion Condition="'$(_BuildInfoVersion)'==''">0.0.0</_BuildInfoVersion>
      <_BuildInfoCommitHash Condition="'$(SourceRevisionId)'!=''">$([System.String]::Copy('$(SourceRevisionId)').Trim())</_BuildInfoCommitHash>
      <_BuildInfoCommitHash Condition="'$(_BuildInfoCommitHash)'==''">unknown</_BuildInfoCommitHash>
      <_BuildInfoInformationalVersion>$(_BuildInfoVersion)</_BuildInfoInformationalVersion>
      <_BuildInfoInformationalVersion Condition="'$(_BuildInfoCommitHash)'!='' and '$(_BuildInfoCommitHash)'!='unknown'">$(_BuildInfoVersion)+$(_BuildInfoCommitHash)</_BuildInfoInformationalVersion>
    </PropertyGroup>

    <ItemGroup>
      <_BuildInfoLines Include="// &lt;auto-generated /&gt;" />
      <_BuildInfoLines Include="namespace $(RootNamespace)" />
      <_BuildInfoLines Include="{" />
      <_BuildInfoLines Include="internal static class BuildInfo" />
      <_BuildInfoLines Include="{" />
      <_BuildInfoLines Include="    internal const string Version = &quot;$(_BuildInfoVersion)&quot;%3B" />
      <_BuildInfoLines Include="    internal const string InformationalVersion = &quot;$(_BuildInfoInformationalVersion)&quot;%3B" />
      <_BuildInfoLines Include="    internal const string CommitHash = &quot;$(_BuildInfoCommitHash)&quot;%3B" />
      <_BuildInfoLines Include="}" />
      <_BuildInfoLines Include="}" />
    </ItemGroup>

    <WriteLinesToFile File="$(_BuildInfoFile)" Lines="@(_BuildInfoLines)" Overwrite="true" Encoding="UTF-8" />

    <ItemGroup>
      <Compile Include="$(_BuildInfoFile)" />
    </ItemGroup>
  </Target>

</Project>
