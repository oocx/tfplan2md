{{~## Template for azuredevops_build_definition
     Uses BuildDefinitionViewModel for pre-computed formatting.
     Access properties via 'change' variable - works for both include and direct render paths.
     Related feature: docs/features/094-build-definition-tables/specification.md
~}}
<details{{ details_open_attr(change) }} style="margin-bottom:12px; border:1px solid rgb(var(--palette-neutral-10, 153, 153, 153)); padding:12px;">
<summary>{{ change.summary_html }}</summary>
<br>
{{~ include "/_code_analysis_metadata.sbn" ~}}

{{ if change.build_definition && change.build_definition.name ~}}
**Pipeline Name:** {{ format_code_summary(change.build_definition.name) }}

{{ end ~}}
{{ if change.build_definition && change.build_definition.path ~}}
**Path:** {{ format_code_summary(change.build_definition.path) }}

{{ end ~}}
{{ if change.build_definition && change.build_definition.agent_pool_name ~}}
**Agent Pool:** {{ format_code_summary(change.build_definition.agent_pool_name) }}

{{ end ~}}
{{~ include "_build_definition_variables.sbn" ~}}
{{~ include "_build_definition_triggers.sbn" ~}}
{{~ include "_build_definition_other_blocks.sbn" ~}}

{{ include "/_code_analysis_findings.sbn" }}

</details>
