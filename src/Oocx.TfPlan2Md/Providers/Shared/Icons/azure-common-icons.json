{
  "rules": [
    {
      "attributeNamePattern": "(?i)^name$",
      "icon": "🆔"
    },
    {
      "attributeNamePattern": "(?i)^resource_group_name$",
      "icon": "📁"
    },
    {
      "attributeNamePattern": "(?i)^subscription(_id)?$",
      "icon": "🔑"
    },
    {
      "attributeNamePattern": "(?i)^(location|region)$",
      "icon": "🌍"
    },
    {
      "attributeNamePattern": "(?i)^(access|action)$",
      "valuePattern": "(?i)^allow$",
      "icon": "✅"
    },
    {
      "attributeNamePattern": "(?i)^(access|action)$",
      "valuePattern": "(?i)^deny$",
      "icon": "⛔"
    },
    {
      "attributeNamePattern": "(?i)^direction$",
      "valuePattern": "(?i)^inbound$",
      "icon": "⬇️"
    },
    {
      "attributeNamePattern": "(?i)^direction$",
      "valuePattern": "(?i)^outbound$",
      "icon": "⬆️"
    },
    {
      "attributeNamePattern": "(?i)^protocol$",
      "valuePattern": "(?i)^tcp$",
      "icon": "🔗"
    },
    {
      "attributeNamePattern": "(?i)^protocol$",
      "valuePattern": "(?i)^udp$",
      "icon": "📨"
    },
    {
      "attributeNamePattern": "(?i)^protocol$",
      "valuePattern": "(?i)^icmp$",
      "icon": "📡"
    },
    {
      "attributeNamePattern": "(?i).*port.*",
      "valuePattern": "^(?!\\*$)[0-9]+(-[0-9]+)?$",
      "icon": "🔌"
    },
    {
      "valuePattern": "(?i)^true$",
      "icon": "✅"
    },
    {
      "valuePattern": "(?i)^false$",
      "icon": "❌"
    },
    {
      "valuePattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}(/([0-9]{1,2}))?$",
      "icon": "🌐"
    }
  ]
}
